# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# source data and recordings (kept locally, not published)
/raw/
*.tif
*.tiff
*.mp4
*.mov
*.shp
*.shx
*.dbf
*.prj
*.cpg

# local clutter
Thumbs.db
desktop.ini
*.zip
*.log
# CVs belong only in public/ (the copy the site serves)
/app/**/*.pdf
